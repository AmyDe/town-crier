{{define "towns"}}{{template "head" .Layout}}      <main>
        <h1>Planning applications by town</h1>
        <p class="lead">Browse {{.Count}} {{.Noun}} we track, A to Z. Pick yours to see what's being built nearby.</p>
        <p class="ctaInline">
          <a class="ctaInline__button" href="{{.StoreHref}}" rel="noopener" target="_blank">Get push alerts for your town →</a>
        </p>

{{- if .Sections}}
        <nav class="townsIndex__jump" aria-label="Jump to letter">
          {{- range .Sections}}
          <a href="#letter-{{.Letter}}">{{.Letter}}</a>
          {{- end}}
        </nav>
{{- range .Sections}}
        <section class="townsIndex__section" id="letter-{{.Letter}}" aria-labelledby="letter-{{.Letter}}-heading">
          <h2 id="letter-{{.Letter}}-heading">{{.Letter}}</h2>
          <ul class="townsIndex__list">
            {{- range .Entries}}
            <li class="townsIndex__item"><a href="{{.Href}}">{{.Name}}</a> <span class="townsIndex__authority">{{.Authority}}</span></li>
            {{- end}}
          </ul>
        </section>
{{- end}}
{{- else}}
        <p class="townsIndex__empty">No towns are published yet — check back soon, or browse by <a href="/planning/">local authority</a> instead.</p>
{{- end}}

        <section class="cta">
          <h2 class="cta__heading">Get push alerts for your town</h2>
          <p>
            Draw a circle on the map and Town Crier will notify you the moment a new
            planning application is submitted or decided inside it.
          </p>
          <a class="cta__button" href="{{.StoreHref}}" rel="noopener" target="_blank">Download on the App Store</a>
        </section>
      </main>
{{template "foot" .Layout}}{{end}}
